# Dependencies
node_modules/

# Backend secrets (never commit)
backend/.env
backend/.env.*
!backend/.env.example
.env
.env.*
!.env.example
.env.local
*.pem

# Logs & OS
npm-debug.log*
.DS_Store
Thumbs.db
# Local backend dev logs may contain phone numbers and OTPs — never commit.
backend-dev.log
backend-dev.err.log
backend-dev*.log
web-client-dev*.log
# Catch-all for stray dev/server logs anywhere in the repo
*.log
!**/CHANGELOG*
# Build artifacts
*.tsbuildinfo
web-client/.next/
web-client/out/

# Flutter
frontend/.dart_tool/
# Ignore build output except web bundle (Vercel serves frontend/build/web).
# Cannot use "frontend/build" + "!frontend/build/web" — Git ignores parent first.
frontend/build/*
!frontend/build/web/
!frontend/build/web/**
frontend/.flutter-plugins-dependencies

# IDE
.idea/
*.iml
.claude/

# Local Flutter SDK checkout (do not commit)
flutter/

# Nested / scratch app dirs (never commit)
veto_app/

# Scratch env dumps produced while syncing Vercel/Render — may hold real values.
scripts/_tmp_*.json

# Lawyer brochure BUILD OUTPUT (~7.5MB of binaries). The source — brochure.html,
# the build scripts and the brand assets — stays tracked; the PDF and the live
# screenshots are regenerated by capture-screens.mjs + build-pdf.mjs.
# See docs/lawyer-brochure/README.md.
docs/lawyer-brochure/*.pdf
docs/lawyer-brochure/screenshots/

.vercel
.env*.local
