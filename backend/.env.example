# ============================================================
#  .env.example — VETO Backend
#  העתק ל-.env ומלא ערכים. קובץ זה בטוח ב-git (ללא סודות).
#  מדריך מפורט: ENV_GUIDE.md
# ============================================================

# ── Server ────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
# Structured (pino) log level: trace|debug|info|warn|error|fatal. Default: debug in dev,
# info in production. Request/response access logs come from pino-http (server.js).
# LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────
# MongoDB Atlas: Cluster → Connect → Drivers → copy string
# https://www.mongodb.com/docs/atlas/driver-connection/
# החלף <username>, <password>, <dbname> · סיסמא: URL-encode אם צריך
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_long_random_secret_min_64_chars
JWT_EXPIRES_IN=30d

# ── Dev-only login (POST /auth/dev-login — local/CI only, never prod) ─
# Requires BOTH NODE_ENV!=='production' AND DEV_LOGIN_ENABLED=1 — there is
# no production override; the endpoint structurally cannot run when
# NODE_ENV==='production', no matter what else is set.
# DEV_LOGIN_ENABLED=1
# DEV_LOGIN_USERNAME=you@example.com
# DEV_LOGIN_PASSWORD=pick_a_local_only_secret

# ── Google OAuth ──────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials — OAuth 2.0 (Web)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# ── Owner role-switcher (POST /auth/view-as) ─────────────
# The Google account matching this email gets `isOwner: true` on its JWT
# and can switch between citizen/lawyer/admin views without logging out.
# OWNER_EMAIL=sysybu@gmail.com

# ── Google Calendar API (OAuth נפרד מהתחברות — סנכרון אירועים) ─
# לקוח OAuth 2.0 נפרד ב-GCP עם scope calendar.events · Redirect: .../api/integrations/gcal/callback
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GCAL_OAUTH_REDIRECT_URI=http://localhost:5001/api/integrations/gcal/callback
# אופציונלי: הפניה אחרי הצלחה (דפדפן)
# GCAL_OAUTH_SUCCESS_REDIRECT=https://your-app.vercel.app/legal_calendar
# מומלץ בפרוד: מפתח הצפנה ייעודי (32+ בתים); אחרת נגזר מ-JWT_SECRET
# GCAL_TOKEN_ENC_KEY=

# ── AI — Google Gemini (צ'אט משפטי + תמלול + ניתוח כספת) ─
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# גודל מקס' לבקשת ניתוח (ברירת מחדל בקוד ~20MB) — אופציונלי
# VAULT_ANALYSIS_MAX_BYTES=20971520

# ── Agora RTC (שיחות וידאו/אודיו — חובה בפרוד אם ב-Agora הופעל App Certificate) ─
# App ID: זהה לקובץ Flutter: frontend/lib/services/agora_service.dart (kAgoraAppIdPlaceholder)
# Certificate: Agora Console → Your project → All features → App ID → show certificate
# בלי certificate: השרת שולח agoraToken ריק; join רק אם הפרויקט ב-Agora מאפשר "Secured" כבוי / join ללא token
# AGORA_APP_ID=b40f2355783a4ccca027a91d0d7100ca
# AGORA_APP_CERTIFICATE=your_app_certificate

# ── Agora Cloud Recording (דפדפן: מיקס מלא → S3 → Cloudinary) ─
# מסוף Agora → Cloud Recording → RESTful customer ID/secret
# https://docs.agora.io/en/cloud-recording/get-started/getstarted
# AGORA_RESTFUL_CUSTOMER_ID=
# AGORA_RESTFUL_CUSTOMER_SECRET=
# AGORA_RESTFUL_DOMAIN=https://api.sd-rtn.com
# מספר אזור S3 לפי Agora vendor=1 — חייב להתאים לאזור ה-bucket (לא לאותו שם כמו AWS!)
# דוגמה: us-east-1 (N. Virginia) → 0 · us-east-2 → 1 · eu-west-1 → 4
# https://docs.agora.io/en/cloud-recording/reference/region-vendor
# AGORA_CR_S3_REGION_NUM=0
# AGORA_CR_S3_BUCKET=your-bucket
# AGORA_CR_S3_ACCESS_KEY=
# AGORA_CR_S3_SECRET_KEY=
# אזור AWS ל-SDK (למשל us-east-1) — חייב להתאים ל-bucket
# AGORA_CR_AWS_REGION=us-east-1

# ── Cloudinary (הקלטות, ראיות, כספה) ─────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Web Push (VAPID) — בדפדפן, לא Firebase ────────────────
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@veto-legal.com

# ── Public API base (יומן — iCal / webcal URL מלא) ───────
# origin בלבד, בלי /api (לדוגמה https://your-api.onrender.com)
# PUBLIC_API_BASE=https://your-api.onrender.com
# (שם חלופי) VETO_PUBLIC_BASE=...

# ── CORS (דפדפן / Vercel) ─────────────────────────────────
# חובה בפרודקשן: רשימה מופרדת בפסיקים של origins מדויקים (HTTPS, בלי / בסוף).
# ללא הגדרה, רק הדיפולטים הקשיחים ב-server.js יאושרו (localhost + הדומיין הרשמי).
CORS_ALLOWED_ORIGINS=https://web-nine-gamma-76.vercel.app,https://veto-legal.vercel.app
# רק לסביבת staging/preview: מאשר כל *.vercel.app (כולל preview deployments של אחרים!).
# לעולם לא בפרודקשן הראשי — זה בדיוק החור שנסגר ב-2026-07.
# ALLOW_VERCEL_PREVIEW_ORIGINS=1

# ── SMTP (אופציונלי — אימייל אירועי יומן / ICS) ──────────
# Resend: https://resend.com/docs/send-with-smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com

# ── Cron (תזכורות — רק אם מריצים node scripts/cron-calendar-reminders.js) ─
# MONGO_URI חייב מוגדר באותו סביבה
# חלון סריקה בדקות (ר' scripts/cron-calendar-reminders.js)
# CALENDAR_REMINDER_WINDOW_MIN=8

# ── Cron (סנכרון Google Calendar — רק אם OAuth מוגדר) ─
# npm run cron:gcal-sync
# GCAL_SYNC_LOOKAHEAD_DAYS=120

# ── NotebookLM Enterprise (אופציונלי, GCP) — לא Firebase ─
# https://cloud.google.com/gemini/enterprise/notebooklm-enterprise/docs
# GCP_PROJECT_ID=your-gcp-project-id
# JSON אחת בשורה — תוכן קובץ service account
# GOOGLE_NOTEBOOKLM_SA_JSON={"type":"service_account",...}
# (שם חלופי) GOOGLE_APPLICATION_CREDENTIALS_JSON=...
# NOTEBOOKLM_ENT_URL=https://notebooklm.cloud.google.com

# PayPal checkout and billing subscriptions
# ⚠️ PAYPAL_WEBHOOK_ID is REQUIRED once PAYPAL_CLIENT_ID/SECRET are set in production —
# the server refuses to boot without it (server.js guardPaypalWebhookInProduction).
# Without it, incoming /api/payments/webhook/paypal calls cannot be signature-verified,
# so paypal.service.js now throws rather than silently accepting unverified events.
# Get it from: PayPal Developer Dashboard → Apps & Credentials → your app → Webhooks.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_STANDARD_PLAN_ID=
PAYPAL_FAMILY_PLAN_ID=
PAYPAL_WEBHOOK_ID=
# Static NIS→USD rate for PayPal capture. Update both vars together when you refresh
# the rate (e.g. against https://www.xe.com or your bank's rate) — the server logs a
# warning once ILS_TO_USD_SET_AT is more than 90 days old (backend/src/config/pricing.js).
ILS_TO_USD=0.275
ILS_TO_USD_SET_AT=2026-01-01
WEB_APP_URL=http://localhost:3000

# ── Monitoring (Sentry) — אופציונלי ──────────────────────
# https://sentry.io — Node.js DSN (עם @ בכתובת)
SENTRY_DSN=

# ── PayPal (תשלומים / מנוי) — אופציונלי ─────────────────
# https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox

# ── Frontend (אחרי תשלום PayPal חוזרים לכאן) — אופציונלי
FRONTEND_URL=https://your-app.vercel.app

# ── WebRTC / TURN (אופציונלי, אך מומלץ בפרוד) ─────────────
# בלי TURN, שיחות מאחורי NAT/פיירוול מגביל (סלולר תאגידי, רשתות ארגוניות) עלולות
# להיכשל בהתחברות. אין תקציב ל-TURN בתשלום? יש שכבות חינם/כמעט-חינם:
#   - Metered.ca (https://www.metered.ca/tools/openrelay/) — TURN חינמי ציבורי,
#     ללא הרשמה, למבחנים/MVP. לא מיועד לעומס פרודקשן רציני.
#   - Cloudflare Calls TURN (https://developers.cloudflare.com/calls/turn/) —
#     tier חינמי נדיב יותר, דורש חשבון Cloudflare (חינמי).
#   - Twilio Network Traversal Service — יש free trial credit, לא tier חינמי קבוע.
# מלאו את אחד מהשניים הבאים (לא את שניהם):
# WEBRTC_ICE_SERVERS_JSON=[{"urls":"turn:openrelay.metered.ca:80","username":"openrelayproject","credential":"openrelayproject"}]
# TURN_URL=turn:turn.example.com:3478?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ── OTP בפיתוח (אין SMS עדיין) — אסור בפרוד בלי Twilio! ─
# RETURN_OTP_IN_JSON=1

# ── Tunnel (פיתוח) ───────────────────────────────────────
# TUNNEL_SUBDOMAIN=sweet-turkey-60

# ============ בלי Firebase — אין למלא: =================
# FCM / firebase-admin: לא
# # FIREBASE_SERVICE_ACCOUNT=
