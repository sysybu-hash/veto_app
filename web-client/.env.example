# Neon Postgres (Prisma) — server-side only; do not expose NEXT_PUBLIC_.
# Repo root: `npm run db:push` loads DATABASE_URL from the repo root `.env` (veto_legal/.env).
# Next.js dev still reads `web-client/.env` — copy DATABASE_URL into both or only here for local dev.
# Vercel: add DATABASE_URL on the web-client project too — `/vault` & Prisma server actions need it at runtime.
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Google Gemini (Vision + server-side analysis). Server-only.
GEMINI_API_KEY=

# Example: https://your-api.onrender.com  — never rely on localhost in production;
# the browser would call the user's own machine (ERR_CONNECTION_REFUSED).
NEXT_PUBLIC_API_ORIGIN=http://localhost:5001

# Google Sign-In (Web client id — same value as backend GOOGLE_CLIENT_ID). Required for /login “המשך עם Google”.
# In Google Cloud Console (OAuth client type “Web”):
# - Authorized JavaScript origins: e.g. http://localhost:3000 and https://your-app.vercel.app
# - Authorized redirect URIs: must include the exact login URL used after Google (implicit flow), e.g.:
#   http://localhost:3000/login
#   https://your-app.vercel.app/login
# Optional override if the login path is not /login on that host:
# NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/login
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Ably (server-side REST publish for SOS). Never expose as NEXT_PUBLIC_.
ABLY_API_KEY=

# Legacy Node file API — vault deleteEvidence POSTs { fileUrl } here when removing remote files.
LEGACY_API_URL=

# SHA-512 digital seal for AI / verified evidence (server-only, long random string).
VETO_PRIVATE_KEY=

# POST /api/debug/stress-test — header x-veto-stress-secret must match this value.
STRESS_TEST_SECRET=

# Web Push (must match VAPID key pair on the backend)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Agora — required for video calls in the browser (`CallRoom`). Same App ID as Agora Console project.
# Set on Vercel for production web-client; without it the call UI shows a localized “missing key” message.
NEXT_PUBLIC_AGORA_APP_ID=
