# Copy to .env.local for local dev (never commit secrets).
# On Vercel, set the same keys in Project → Settings → Environment Variables.

# API origin only (no /api suffix). Defaults to http://localhost:5001 if unset.
NEXT_PUBLIC_API_ORIGIN=http://localhost:5001

# Web Push (must match VAPID key pair on the backend)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Agora (browser calls)
# NEXT_PUBLIC_AGORA_APP_ID=
