# Neon Postgres (Prisma) — server-side only; do not expose NEXT_PUBLIC_.
# Repo root: `npm run db:push` loads DATABASE_URL from the repo root `.env` (veto_legal/.env).
# Next.js dev reads `web-client/.env`. Copy DATABASE_URL to repo root `.env` too if you use db:push from root.
#
# Sync allowlisted keys to Vercel + Render (from repo root): npm run env:sync -- --vercel --render --target production
# Default source file is `web-client/.env` when it exists.
#
# --- Browser (NEXT_PUBLIC_*) ---
# Production API origin (HTTPS, no /api). Required for Vercel production builds.
NEXT_PUBLIC_API_ORIGIN=https://your-service.onrender.com
# Optional: used only in `next dev` — overrides NEXT_PUBLIC_API_ORIGIN so local dev hits local API.
NEXT_PUBLIC_API_ORIGIN_DEV=http://localhost:5001
# Canonical site URL for metadata / sitemap / OG (your Vercel URL or custom domain).
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Public support channels (shown on /contact and legal pages).
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Optional E.164 digits only, e.g. 972501234567 → https://wa.me/972501234567
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# PostHog (loaded only after CookieConsent analytics=true).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

DATABASE_URL=

# Google Gemini (Vision + server-side analysis). Server-only.
GEMINI_API_KEY=

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Sign-In (Web client id — same value as backend GOOGLE_CLIENT_ID). Required for /login “המשך עם Google”.
# Redirect URI is built in the browser as {current-origin}/login — list every host you use in GCP:
# - Authorized JavaScript origins: https://your-app.vercel.app , http://localhost:3000 , http://127.0.0.1:3000
# - Authorized redirect URIs (exact): https://your-app.vercel.app/login , http://localhost:3000/login , …
# Avoid NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT_URI on Vercel if it points at a different host than the open site (redirect_uri_mismatch).
# NEXT_PUBLIC_GOOGLE_OAUTH_REDIRECT_URI=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Ably (server-side REST publish for SOS). Never expose as NEXT_PUBLIC_.
ABLY_API_KEY=

# Backend origin for vault remote delete (POST /api/vault/delete-remote).
# Defaults to NEXT_PUBLIC_API_ORIGIN when unset. Prefer setting this explicitly on Vercel.
LEGACY_API_URL=
# Optional fallback bearer if the user JWT cookie is unavailable (prefer JWT).
LEGACY_API_TOKEN=

# SHA-512 digital seal for AI / verified evidence (server-only, long random string).
VETO_PRIVATE_KEY=

# POST /api/debug/stress-test — header x-veto-stress-secret must match this value.
STRESS_TEST_SECRET=

# Web Push — same base64 public key as backend VAPID_PUBLIC_KEY (required in browser bundle).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# PayPal Smart Buttons (same PayPal app Client ID as backend PAYPAL_CLIENT_ID).
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Sentry browser SDK — same project DSN as SENTRY_DSN (safe to expose in bundle).
# NEXT_PUBLIC_SENTRY_DSN=

# Agora — required for video calls in the browser (`CallRoom`). Same App ID as Agora Console / backend AGORA_APP_ID.
NEXT_PUBLIC_AGORA_APP_ID=
